---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VimeoEmbed from '../../components/VimeoEmbed.astro';
import Gallery from '../../components/Gallery.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getVimeoMeta } from '../../lib/vimeo';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => data.status !== 'draft');
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await work.render();
const { data } = work;
const year = data.year?.slice(0, 4) ?? '';

const all = await getCollection('works', ({ data: d }) => d.status !== 'draft');
const related = all
  .filter((w) => w.slug !== work.slug)
  .map((w) => ({
    w,
    overlap: w.data.tags.filter((t) => data.tags.includes(t)).length,
  }))
  .filter(({ overlap }) => overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 3)
  .map(({ w }) => w);

const collabTags = data.tags.filter((t) => t.startsWith('with-'));
const rawHero = data.featuredImage
  || (data.vimeoId ? (await getVimeoMeta(data.vimeoId))?.thumbnail : null);
const heroImage = rawHero ? withBase(rawHero) : null;

const scWidgetUrl = data.soundcloudUrl
  ? `https://w.soundcloud.com/player/?url=${encodeURIComponent(data.soundcloudUrl)}&color=%23c47a3a&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false`
  : null;
---
<Base title={`${data.title} — SLEEP NOD`} description={data.summary}>
  <article class="container work">
    {data.vimeoId ? (
      <div class="work-hero" style="background: transparent;">
        <VimeoEmbed vimeoId={data.vimeoId} title={data.title} />
      </div>
    ) : data.youtubeId ? (
      <div class="work-hero" style="background: #000;">
        <iframe
          src={`https://www.youtube.com/embed/${data.youtubeId}`}
          title={data.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          style="width:100%;height:100%;border:0;"
        ></iframe>
      </div>
    ) : heroImage ? (
      <div class="work-hero">
        <img src={heroImage} alt={data.title} />
      </div>
    ) : null}

    {scWidgetUrl && (
      <div class="work-embed">
        <iframe
          src={scWidgetUrl}
          allow="autoplay"
          style="width:100%;height:166px;border:0;"
        ></iframe>
      </div>
    )}

    {data.bandcampEmbedUrl && (
      <div class="work-embed">
        <iframe
          src={data.bandcampEmbedUrl}
          seamless
          style="width:100%;height:120px;border:0;"
        ></iframe>
      </div>
    )}

    <header>
      <h1>{data.preservedTitle || data.title}</h1>
      <p class="meta-line">
        {data.medium}{year ? ` · ${year}` : ''}{data.venue ? ` · ${data.venue}` : ''}
      </p>
      {data.role && <p class="role">{data.role}</p>}
    </header>

    <div class="body">
      <Content />
    </div>

    <Gallery items={data.gallery} />

    {collabTags.length > 0 && (
      <aside class="collaborators">
        <h2>Collaborators</h2>
        <ul>
          {collabTags.map((tag) => (
            <li><a href={withBase(`/with/${tag.replace(/^with-/, '')}/`)}>{tag.replace(/^with-/, '').replace(/-/g, ' ')}</a></li>
          ))}
        </ul>
      </aside>
    )}

    {data.substackUrl && (
      <aside>
        <h2>Further reading</h2>
        <p><a href={data.substackUrl} target="_blank" rel="noopener">Read on Substack ↗</a></p>
      </aside>
    )}

    {related.length > 0 && (
      <aside class="related">
        <h2>Related</h2>
        <div class="work-grid work-grid--dense">
          {related.map((w) => <WorkCard work={w} />)}
        </div>
      </aside>
    )}
  </article>
</Base>
