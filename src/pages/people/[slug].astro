---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

export async function getStaticPaths() {
  const people = await getCollection('people', ({ data }) => data.published !== false);
  const works = await getCollection('works', ({ data }) => data.status !== 'draft');
  return people.map((person) => ({
    params: { slug: person.id },
    props: {
      person,
      works: works
        .filter((w) => w.data.collaborators.some((ref) => ref.id === person.id))
        .sort((a, b) => (b.data.year ?? '').localeCompare(a.data.year ?? '')),
    },
  }));
}

const { person, works } = Astro.props;
const { data } = person;
---
<Base title={`${data.preservedName || data.name} — SLEEP NOD`}>
  <section class="container" style="padding-block: 3rem 2rem;">
    <div class="section-label">Collaborator</div>
    <h1 style="font-family: var(--serif); font-weight: 700; font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.05; margin: 0;">{data.preservedName || data.name}</h1>
    {data.preservedName && data.preservedName !== data.name && (
      <p class="meta-line" style="margin-top: 0.5rem;">{data.name}</p>
    )}
    {data.role.length > 0 && (
      <p class="meta-line" style="margin-top: 0.25rem;">{data.role.join(' · ')}</p>
    )}
    {data.bio && <p style="margin-top: 1rem; max-width: 60ch;">{data.bio}</p>}
    {data.links.length > 0 && (
      <ul style="margin-top: 1rem; list-style: none; padding: 0; display: flex; gap: 1rem; flex-wrap: wrap;">
        {data.links.map((l) => (
          <li><a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a></li>
        ))}
      </ul>
    )}
  </section>
  {works.length > 0 && (
    <section class="container">
      <div class="work-grid work-grid--dense">
        {works.map((w) => <WorkCard work={w} />)}
      </div>
    </section>
  )}
</Base>
