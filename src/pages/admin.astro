---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getVimeoMeta } from '../lib/vimeo';
import { withBase } from '../lib/url';

// Admin page: visual catalog + in-browser editing drawer + CSV round-trip.
//
// Security posture: cosmetic passphrase gate. Works data is in page HTML regardless.
// Real protection is the unlisted URL + robots.txt Disallow. Retire for Keystatic (Phase 2).

const works = await getCollection('works');
const people = await getCollection('people');
const venues = await getCollection('venues');

type AdminRow = {
  slug: string;
  file: string;
  title: string;
  preservedTitle: string;
  year: string;
  medium: string;
  role: string;
  venue: string;
  venueRef: string;
  collaborators: string[];
  tags: string[];
  section: string;
  summary: string;
  featuredImage: string;
  vimeoId: string;
  vimeoPrivacy: string;
  youtubeId: string;
  soundcloudUrl: string;
  bandcampEmbedUrl: string;
  status: string;
  featuredOrder: number | '';
  archivePath: string;
  rightsNote: string;
  substackUrl: string;
  gallery: Array<{ src: string; caption?: string }>;
  body: string;
  thumbnail: string | null;
};

type AdminPerson = {
  slug: string;
  name: string;
  preservedName: string;
  role: string[];
  bio: string;
  links: Array<{ label: string; url: string }>;
  archivePath: string;
  published: boolean;
};

type AdminVenue = {
  slug: string;
  name: string;
  preservedName: string;
  city: string;
  country: string;
  website: string;
  note: string;
  published: boolean;
};

const rows: AdminRow[] = await Promise.all(
  works.map(async (w): Promise<AdminRow> => {
    const vimeoPoster = w.data.vimeoId ? (await getVimeoMeta(w.data.vimeoId))?.thumbnail : null;
    return {
      slug: w.slug,
      file: `src/content/works/${w.id}`,
      title: w.data.title,
      preservedTitle: w.data.preservedTitle ?? '',
      year: w.data.year ?? '',
      medium: w.data.medium,
      role: w.data.role ?? '',
      venue: w.data.venue ?? '',
      venueRef: w.data.venueRef?.id ?? '',
      collaborators: (w.data.collaborators ?? []).map((ref: { id: string }) => ref.id),
      tags: w.data.tags,
      section: w.data.section ?? '',
      summary: w.data.summary ?? '',
      featuredImage: w.data.featuredImage ?? '',
      vimeoId: w.data.vimeoId ?? '',
      vimeoPrivacy: w.data.vimeoPrivacy,
      youtubeId: w.data.youtubeId ?? '',
      soundcloudUrl: w.data.soundcloudUrl ?? '',
      bandcampEmbedUrl: w.data.bandcampEmbedUrl ?? '',
      status: w.data.status,
      featuredOrder: w.data.featuredOrder ?? '',
      archivePath: w.data.archivePath ?? '',
      rightsNote: w.data.rightsNote ?? '',
      substackUrl: w.data.substackUrl ?? '',
      gallery: w.data.gallery,
      body: w.body ?? '',
      thumbnail: w.data.featuredImage || vimeoPoster || null,
    };
  })
);

rows.sort((a, b) => (b.year ?? '').localeCompare(a.year ?? ''));

const peopleRows: AdminPerson[] = people
  .map((p): AdminPerson => ({
    slug: p.id,
    name: p.data.name,
    preservedName: p.data.preservedName ?? '',
    role: p.data.role,
    bio: p.data.bio ?? '',
    links: p.data.links,
    archivePath: p.data.archivePath ?? '',
    published: p.data.published,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const venueRows: AdminVenue[] = venues
  .map((v): AdminVenue => ({
    slug: v.id,
    name: v.data.name,
    preservedName: v.data.preservedName ?? '',
    city: v.data.city ?? '',
    country: v.data.country ?? '',
    website: v.data.website ?? '',
    note: v.data.note ?? '',
    published: v.data.published,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const stats = {
  total: rows.length,
  featured: rows.filter((r) => r.status === 'featured').length,
  published: rows.filter((r) => r.status === 'published').length,
  draft: rows.filter((r) => r.status === 'draft').length,
};

const mediums = Array.from(new Set(rows.map((r) => r.medium))).sort();
const placeholder = withBase('/media/placeholder.svg');
---

<Base title="SLEEP NOD Admin">
  <div id="gate" class="admin-gate">
    <div class="admin-gate-box">
      <h1>SLEEP NOD Admin</h1>
      <p>Passphrase.</p>
      <input type="password" id="gate-pw" autocomplete="off" autofocus />
      <button id="gate-btn" type="button">Enter</button>
    </div>
  </div>

  <div id="admin" class="admin-panel" style="display:none;">
    <header class="admin-header">
      <h1>Vault admin</h1>
      <div class="admin-stats">
        {stats.total} works · {peopleRows.length} people · {venueRows.length} venues
      </div>
      <nav class="admin-tabs" role="tablist">
        <button type="button" class="admin-tab active" data-tab="works" role="tab">Works <span class="tab-count">{stats.total}</span></button>
        <button type="button" class="admin-tab" data-tab="people" role="tab">People <span class="tab-count">{peopleRows.length}</span></button>
        <button type="button" class="admin-tab" data-tab="venues" role="tab">Venues <span class="tab-count">{venueRows.length}</span></button>
      </nav>
    </header>

    <section class="admin-tab-panel" data-panel="works">
    <div class="admin-toolbar">
      <input id="search" placeholder="Search title, slug, tags, summary…" class="admin-input" />
      <select id="filter-status" class="admin-select">
        <option value="all">All statuses</option>
        <option value="featured">Featured</option>
        <option value="published">Published</option>
        <option value="draft">Draft</option>
      </select>
      <select id="filter-medium" class="admin-select">
        <option value="all">All mediums</option>
        {mediums.map((m) => <option value={m}>{m}</option>)}
      </select>
      <button id="export-csv" class="admin-btn" type="button">Download CSV</button>
      <label class="admin-btn admin-btn--outline">
        Upload CSV
        <input type="file" id="import-csv" accept=".csv" hidden />
      </label>
      <button id="download-changes" class="admin-btn admin-btn--accent" type="button" style="display:none;">Download changes</button>
      <span id="row-count" class="admin-count"></span>
    </div>

    <div id="import-result" class="admin-import-result" hidden></div>

    <div class="admin-table-wrap">
      <table class="admin-table" id="data-table">
        <thead>
          <tr>
            <th class="col-thumb"></th>
            <th class="sortable" data-col="status">Status</th>
            <th class="sortable col-title" data-col="title">Title · slug</th>
            <th class="sortable" data-col="year">Year</th>
            <th class="sortable" data-col="medium">Medium</th>
            <th class="col-embeds">Embeds</th>
            <th class="col-summary">Summary</th>
            <th class="col-flags">Flags</th>
          </tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
    </div>

    <p class="admin-note">
      <strong>Quick edit:</strong> click a row to open the editor — set status, embed IDs, summary, tags.
      Click a <em>status pill</em> to cycle it instantly (draft → published → featured → draft).
      Changes are held in memory across all tabs; click <em>Download changes</em> to get a zip with
      <code>works/</code>, <code>people/</code>, <code>venues/</code> subfolders — unzip into <code>src/content/</code>
      and commit + push.<br>
      <strong>Bulk edit:</strong> <em>Download CSV</em> → edit in Sheets/Excel → <em>Upload CSV</em> →
      zip of updated works. <code>gallery</code> and body are preserved across both flows.
    </p>
    </section>

    <section class="admin-tab-panel" data-panel="people" hidden>
      <div class="admin-toolbar">
        <input id="people-search" placeholder="Search name, slug, role, bio…" class="admin-input" />
        <button id="people-new" class="admin-btn" type="button">New person</button>
        <span id="people-count" class="admin-count"></span>
      </div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="col-title">Name · slug</th>
              <th>Role</th>
              <th>Bio</th>
              <th>Links</th>
              <th>Published</th>
            </tr>
          </thead>
          <tbody id="people-tbody"></tbody>
        </table>
      </div>
      <p class="admin-note">
        Click a row to edit. Click <em>New person</em> to seed a row (e.g. for unmatched
        <code>with-*</code> tags). People are stored as <code>src/content/people/&lt;slug&gt;.json</code>.
      </p>
    </section>

    <section class="admin-tab-panel" data-panel="venues" hidden>
      <div class="admin-toolbar">
        <input id="venues-search" placeholder="Search name, slug, city, note…" class="admin-input" />
        <button id="venues-new" class="admin-btn" type="button">New venue</button>
        <span id="venues-count" class="admin-count"></span>
      </div>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th class="col-title">Name · slug</th>
              <th>City</th>
              <th>Country</th>
              <th>Website</th>
              <th>Note</th>
              <th>Published</th>
            </tr>
          </thead>
          <tbody id="venues-tbody"></tbody>
        </table>
      </div>
      <p class="admin-note">
        Venues are stored as <code>src/content/venues/&lt;slug&gt;.json</code>.
      </p>
    </section>
  </div>

  <!-- Edit drawer overlay -->
  <div id="drawer-overlay" class="drawer-overlay"></div>

  <!-- Edit drawer -->
  <aside id="edit-drawer" class="edit-drawer" aria-label="Edit work">
    <div class="drawer-header">
      <span id="drawer-title" class="drawer-title"></span>
      <button id="drawer-close" type="button" aria-label="Close">×</button>
    </div>
    <div class="drawer-body">
      <fieldset class="drawer-section">
        <legend>Visibility</legend>
        <div class="status-btns">
          <button type="button" data-status="draft">Draft</button>
          <button type="button" data-status="published">Published</button>
          <button type="button" data-status="featured">Featured</button>
        </div>
        <div id="featured-order-row" class="form-row" style="display:none;">
          <label for="d-featuredOrder">Featured order</label>
          <input type="number" id="d-featuredOrder" min="1" placeholder="1" />
        </div>
      </fieldset>

      <fieldset class="drawer-section">
        <legend>Embeds</legend>
        <div class="form-row">
          <label for="d-vimeoId">Vimeo ID</label>
          <input type="text" id="d-vimeoId" placeholder="e.g. 123456789" />
        </div>
        <div class="form-row">
          <label for="d-youtubeId">YouTube ID</label>
          <input type="text" id="d-youtubeId" placeholder="e.g. dQw4w9WgXcQ" />
        </div>
        <div class="form-row">
          <label for="d-soundcloudUrl">SoundCloud URL</label>
          <input type="text" id="d-soundcloudUrl" placeholder="https://soundcloud.com/…" />
        </div>
        <div class="form-row">
          <label for="d-bandcampEmbedUrl">Bandcamp embed URL</label>
          <input type="text" id="d-bandcampEmbedUrl" placeholder="https://bandcamp.com/EmbeddedPlayer/…" />
        </div>
      </fieldset>

      <fieldset class="drawer-section">
        <legend>Content</legend>
        <div class="form-row">
          <label for="d-summary">Summary</label>
          <textarea id="d-summary" rows="3"></textarea>
        </div>
        <div class="form-row">
          <label for="d-tags">Tags</label>
          <input type="text" id="d-tags" placeholder="comma or pipe separated" />
        </div>
      </fieldset>
    </div>
    <div class="drawer-footer">
      <button id="drawer-save" class="admin-btn" type="button">Save</button>
      <button id="drawer-cancel" class="admin-btn admin-btn--outline" type="button">Cancel</button>
    </div>
  </aside>

  <!-- Person drawer -->
  <aside id="person-drawer" class="edit-drawer" aria-label="Edit person">
    <div class="drawer-header">
      <span id="person-drawer-title" class="drawer-title"></span>
      <button id="person-drawer-close" type="button" aria-label="Close">×</button>
    </div>
    <div class="drawer-body">
      <fieldset class="drawer-section">
        <legend>Identity</legend>
        <div class="form-row">
          <label for="p-slug">Slug</label>
          <input type="text" id="p-slug" placeholder="e.g. anna-conda" />
        </div>
        <div class="form-row">
          <label for="p-name">Name</label>
          <input type="text" id="p-name" placeholder="Readable name" />
        </div>
        <div class="form-row">
          <label for="p-preservedName">Preserved name (optional)</label>
          <input type="text" id="p-preservedName" placeholder="If idiosyncratic typography" />
        </div>
        <div class="form-row">
          <label for="p-role">Role</label>
          <input type="text" id="p-role" placeholder="comma-separated: Choreographer, Performer" />
        </div>
      </fieldset>
      <fieldset class="drawer-section">
        <legend>Content</legend>
        <div class="form-row">
          <label for="p-bio">Bio</label>
          <textarea id="p-bio" rows="4"></textarea>
        </div>
        <div class="form-row">
          <label for="p-archivePath">Archive path (optional)</label>
          <input type="text" id="p-archivePath" placeholder="Internal reference" />
        </div>
      </fieldset>
      <fieldset class="drawer-section">
        <legend>Visibility</legend>
        <div class="form-row">
          <label>
            <input type="checkbox" id="p-published" /> Published
          </label>
        </div>
      </fieldset>
    </div>
    <div class="drawer-footer">
      <button id="person-drawer-save" class="admin-btn" type="button">Save</button>
      <button id="person-drawer-cancel" class="admin-btn admin-btn--outline" type="button">Cancel</button>
    </div>
  </aside>

  <!-- Venue drawer -->
  <aside id="venue-drawer" class="edit-drawer" aria-label="Edit venue">
    <div class="drawer-header">
      <span id="venue-drawer-title" class="drawer-title"></span>
      <button id="venue-drawer-close" type="button" aria-label="Close">×</button>
    </div>
    <div class="drawer-body">
      <fieldset class="drawer-section">
        <legend>Identity</legend>
        <div class="form-row">
          <label for="v-slug">Slug</label>
          <input type="text" id="v-slug" placeholder="e.g. joes-pub" />
        </div>
        <div class="form-row">
          <label for="v-name">Name</label>
          <input type="text" id="v-name" placeholder="Readable name" />
        </div>
        <div class="form-row">
          <label for="v-preservedName">Preserved name (optional)</label>
          <input type="text" id="v-preservedName" placeholder="If idiosyncratic typography" />
        </div>
      </fieldset>
      <fieldset class="drawer-section">
        <legend>Location</legend>
        <div class="form-row">
          <label for="v-city">City</label>
          <input type="text" id="v-city" />
        </div>
        <div class="form-row">
          <label for="v-country">Country</label>
          <input type="text" id="v-country" />
        </div>
      </fieldset>
      <fieldset class="drawer-section">
        <legend>Details</legend>
        <div class="form-row">
          <label for="v-website">Website</label>
          <input type="text" id="v-website" placeholder="https://…" />
        </div>
        <div class="form-row">
          <label for="v-note">Note</label>
          <textarea id="v-note" rows="3"></textarea>
        </div>
      </fieldset>
      <fieldset class="drawer-section">
        <legend>Visibility</legend>
        <div class="form-row">
          <label>
            <input type="checkbox" id="v-published" /> Published
          </label>
        </div>
      </fieldset>
    </div>
    <div class="drawer-footer">
      <button id="venue-drawer-save" class="admin-btn" type="button">Save</button>
      <button id="venue-drawer-cancel" class="admin-btn admin-btn--outline" type="button">Cancel</button>
    </div>
  </aside>

  <script id="admin-data" type="application/json" set:html={JSON.stringify(rows)}></script>
  <script id="admin-people" type="application/json" set:html={JSON.stringify(peopleRows)}></script>
  <script id="admin-venues" type="application/json" set:html={JSON.stringify(venueRows)}></script>
  <script id="admin-placeholder" type="text/plain" set:html={placeholder}></script>

  <style>
    /* Gate */
    .admin-gate {
      min-height: 70vh;
      display: grid;
      place-items: center;
      padding: 2rem;
    }
    .admin-gate-box {
      max-width: 360px;
      width: 100%;
      text-align: center;
    }
    .admin-gate-box h1 {
      font-family: var(--serif);
      font-size: 2rem;
      margin: 0 0 0.25rem;
    }
    .admin-gate-box p {
      color: var(--muted);
      font-family: var(--mono);
      font-size: 0.8125rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin: 0 0 1.5rem;
    }
    .admin-gate-box input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-family: var(--mono);
      font-size: 1rem;
      border: 1px solid var(--rule);
      background: transparent;
      color: var(--ink);
      margin-bottom: 0.75rem;
    }
    .admin-gate-box input:focus { outline: 2px solid var(--ink); outline-offset: -1px; }
    .admin-gate-box button {
      width: 100%;
      padding: 0.75rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: var(--ink);
      color: var(--bg);
      border: 0;
      cursor: pointer;
    }
    .admin-gate-box button:hover { opacity: 0.85; }

    /* Panel */
    .admin-panel {
      padding: 1.5rem clamp(1rem, 3vw, 2rem) 6rem;
      max-width: 100%;
    }
    .admin-header { margin-bottom: 1rem; padding-bottom: 0; border-bottom: 0; }
    .admin-header h1 { font-family: var(--serif); font-size: 1.75rem; margin: 0 0 0.25rem; }
    .admin-stats {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .admin-tabs {
      display: flex;
      gap: 0;
      border-bottom: 1px solid var(--rule);
    }
    .admin-tab {
      padding: 0.75rem 1.25rem;
      font-family: var(--mono);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: transparent;
      color: var(--muted);
      border: 0;
      border-bottom: 2px solid transparent;
      cursor: pointer;
      margin-bottom: -1px;
    }
    .admin-tab:hover { color: var(--ink); }
    .admin-tab.active {
      color: var(--ink);
      border-bottom-color: var(--ink);
    }
    .admin-tab .tab-count {
      display: inline-block;
      margin-left: 0.375rem;
      font-size: 0.6875rem;
      color: var(--muted);
    }
    .admin-tab.active .tab-count { color: var(--ink); }
    .admin-tab-panel { padding-top: 1rem; }

    /* Toolbar */
    .admin-toolbar {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 5;
      background: var(--bg);
      padding: 0.75rem 0;
      margin-bottom: 0.5rem;
    }
    .admin-input, .admin-select {
      padding: 0.5rem 0.75rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      border: 1px solid var(--rule);
      background: transparent;
      color: var(--ink);
    }
    .admin-input { flex: 1; min-width: 180px; }
    .admin-btn {
      padding: 0.5rem 1rem;
      font-family: var(--mono);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: var(--ink);
      color: var(--bg);
      border: 0;
      cursor: pointer;
      white-space: nowrap;
    }
    .admin-btn--outline {
      background: transparent;
      color: var(--ink);
      border: 1px solid var(--ink);
    }
    .admin-btn--accent {
      background: #c47a3a;
      color: #fff;
    }
    .admin-btn:hover { opacity: 0.85; }
    .admin-count {
      margin-left: auto;
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--muted);
    }

    /* Import result */
    .admin-import-result {
      margin: 1rem 0;
      padding: 1rem 1.25rem;
      border: 1px solid var(--rule);
      background: rgba(255,255,255,0.04);
      font-family: var(--mono);
      font-size: 0.8125rem;
      line-height: 1.6;
    }
    .admin-import-result ul { margin: 0.5rem 0 1rem; padding-left: 1.25rem; }
    .admin-import-result code {
      background: rgba(255,255,255,0.08);
      padding: 0 0.25rem;
      font-size: 0.8125rem;
    }
    .admin-import-result a.admin-btn { display: inline-block; text-decoration: none; }

    /* Table */
    .admin-table-wrap { overflow-x: auto; }
    .admin-table {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--mono);
      font-size: 0.8125rem;
    }
    .admin-table th, .admin-table td {
      padding: 0.5rem 0.75rem;
      text-align: left;
      border-bottom: 1px solid var(--rule);
      vertical-align: top;
    }
    .admin-table th {
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.6875rem;
      color: var(--muted);
      white-space: nowrap;
    }
    .admin-table th.sortable { cursor: pointer; user-select: none; }
    .admin-table th.sortable:hover { color: var(--ink); }
    .admin-table th.sort-asc::after { content: ' ↑'; }
    .admin-table th.sort-desc::after { content: ' ↓'; }

    .admin-table .col-thumb { width: 80px; }
    .admin-table .col-title { min-width: 240px; }
    .admin-table .col-embeds { width: 100px; white-space: nowrap; }
    .admin-table .col-summary { max-width: 260px; }
    .admin-table .col-flags { white-space: nowrap; }

    .admin-table tbody tr { cursor: pointer; }
    .admin-table tbody tr:hover td { background: rgba(255,255,255,0.03); }
    .admin-table tbody tr.row-pending { border-left: 3px solid #c47a3a; }
    .admin-table tbody tr.row-pending td:first-child { padding-left: calc(0.75rem - 3px); }

    .thumb {
      width: 72px;
      height: 44px;
      object-fit: cover;
      background: var(--card-bg);
      display: block;
    }

    .title-cell strong {
      font-family: var(--serif);
      font-size: 0.9375rem;
      font-weight: 600;
      display: block;
      line-height: 1.2;
    }
    .title-cell small {
      color: var(--muted);
      font-size: 0.75rem;
    }

    .status-pill {
      display: inline-block;
      padding: 0.125rem 0.5rem;
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: 1px solid currentColor;
      cursor: pointer;
      user-select: none;
    }
    .status-pill:hover { opacity: 0.75; }
    .status-pill.featured { color: #d46040; }
    .status-pill.published { color: #3a9a7a; }
    .status-pill.draft { color: var(--muted); }

    .embed-badge {
      display: inline-block;
      padding: 0.1rem 0.3rem;
      font-size: 0.625rem;
      letter-spacing: 0.04em;
      font-weight: 600;
      color: var(--muted);
      border: 1px solid rgba(255,255,255,0.1);
      margin-right: 0.2rem;
    }
    .embed-badge--on {
      color: #c47a3a;
      border-color: rgba(196,122,58,0.4);
    }

    .flag {
      display: inline-block;
      padding: 0.125rem 0.375rem;
      margin-right: 0.25rem;
      font-size: 0.6875rem;
      background: rgba(180,110,20,0.15);
      color: #c4853a;
      white-space: nowrap;
    }
    .flag.ok { background: transparent; color: var(--muted); }

    .truncate {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .admin-note {
      margin-top: 2rem;
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--rule);
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--muted);
      line-height: 1.7;
    }
    .admin-note strong { color: var(--ink); font-weight: 500; }
    .admin-note code {
      background: rgba(255,255,255,0.08);
      padding: 0 0.25rem;
    }
    .admin-note em { font-style: normal; color: var(--ink); }

    /* Drawer overlay */
    .drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 40;
      display: none;
    }
    .drawer-overlay.open { display: block; }

    /* Drawer panel */
    .edit-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: min(420px, 100vw);
      height: 100dvh;
      background: var(--bg);
      border-left: 1px solid var(--rule);
      z-index: 50;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 240ms ease;
      overflow: hidden;
    }
    .edit-drawer.open { transform: translateX(0); }

    .drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--rule);
      flex-shrink: 0;
    }
    .drawer-title {
      font-family: var(--serif);
      font-size: 0.9375rem;
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .drawer-header button {
      font-family: var(--mono);
      font-size: 1.375rem;
      line-height: 1;
      color: var(--muted);
      padding: 0.125rem 0.25rem;
      flex-shrink: 0;
    }
    .drawer-header button:hover { color: var(--ink); }

    .drawer-body {
      flex: 1;
      overflow-y: auto;
      padding: 1.25rem;
    }

    .drawer-section {
      border: 0;
      padding: 0;
      margin: 0 0 1.75rem;
    }
    .drawer-section legend {
      font-family: var(--mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      margin-bottom: 0.875rem;
      padding: 0;
    }

    .status-btns {
      display: flex;
      gap: 0.375rem;
      margin-bottom: 0.875rem;
    }
    .status-btns button {
      flex: 1;
      padding: 0.5rem 0.25rem;
      font-family: var(--mono);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: 1px solid var(--rule);
      color: var(--muted);
      cursor: pointer;
      background: transparent;
      transition: background 150ms, color 150ms, border-color 150ms;
    }
    .status-btns button.active {
      background: var(--ink);
      color: var(--bg);
      border-color: var(--ink);
    }
    .status-btns button[data-status="featured"].active { background: #d46040; border-color: #d46040; color: #fff; }
    .status-btns button[data-status="published"].active { background: #3a9a7a; border-color: #3a9a7a; color: #fff; }

    .form-row {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      margin-bottom: 0.875rem;
    }
    .form-row label {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--muted);
      letter-spacing: 0.04em;
    }
    .form-row input,
    .form-row textarea {
      padding: 0.5rem 0.75rem;
      font-family: var(--mono);
      font-size: 0.8125rem;
      border: 1px solid var(--rule);
      background: transparent;
      color: var(--ink);
      width: 100%;
    }
    .form-row input:focus,
    .form-row textarea:focus {
      outline: 1px solid rgba(240,236,227,0.4);
      outline-offset: -1px;
    }
    .form-row textarea { resize: vertical; }

    .drawer-footer {
      display: flex;
      gap: 0.5rem;
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--rule);
      flex-shrink: 0;
    }
    .drawer-footer .admin-btn { flex: 1; text-align: center; }
  </style>

  <script>
    import JSZip from 'jszip';

    const HASH = '111db19e5ce5';
    const STORAGE_KEY = 'sleepnod-admin';

    type AdminRow = {
      slug: string; file: string; title: string; preservedTitle: string;
      year: string; medium: string; role: string; venue: string;
      venueRef: string; collaborators: string[];
      tags: string[]; section: string; summary: string;
      featuredImage: string; vimeoId: string; vimeoPrivacy: string;
      youtubeId: string; soundcloudUrl: string; bandcampEmbedUrl: string;
      status: string; featuredOrder: number | '';
      archivePath: string; rightsNote: string; substackUrl: string;
      gallery: Array<{ src: string; caption?: string }>;
      body: string; thumbnail: string | null;
    };

    type AdminPerson = {
      slug: string; name: string; preservedName: string;
      role: string[]; bio: string;
      links: Array<{ label: string; url: string }>;
      archivePath: string; published: boolean;
    };

    type AdminVenue = {
      slug: string; name: string; preservedName: string;
      city: string; country: string; website: string;
      note: string; published: boolean;
    };

    const DATA: AdminRow[] = JSON.parse(
      (document.getElementById('admin-data') as HTMLScriptElement).textContent || '[]'
    );
    const PEOPLE: AdminPerson[] = JSON.parse(
      (document.getElementById('admin-people') as HTMLScriptElement).textContent || '[]'
    );
    const VENUES: AdminVenue[] = JSON.parse(
      (document.getElementById('admin-venues') as HTMLScriptElement).textContent || '[]'
    );
    const PLACEHOLDER = (document.getElementById('admin-placeholder') as HTMLScriptElement).textContent || '';

    // --- Gate ---
    const gate = document.getElementById('gate') as HTMLDivElement;
    const admin = document.getElementById('admin') as HTMLDivElement;
    const pwInput = document.getElementById('gate-pw') as HTMLInputElement;
    const pwBtn = document.getElementById('gate-btn') as HTMLButtonElement;

    async function hashPw(pw: string): Promise<string> {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw));
      return Array.from(new Uint8Array(buf)).map((b) => b.toString(16).padStart(2, '0')).join('').slice(0, HASH.length);
    }

    async function tryLogin() {
      const h = await hashPw(pwInput.value.trim().toLowerCase());
      if (h === HASH) {
        gate.style.display = 'none';
        admin.style.display = 'block';
        sessionStorage.setItem(STORAGE_KEY, '1');
        init();
      } else {
        pwInput.value = '';
        pwInput.placeholder = 'Wrong passphrase';
        pwInput.style.borderColor = '#d46040';
      }
    }

    pwBtn.addEventListener('click', tryLogin);
    pwInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') tryLogin(); });

    // --- Pending changes (works + people + venues) ---
    const pending = new Map<string, AdminRow>();
    const peoplePending = new Map<string, AdminPerson>();
    const venuesPending = new Map<string, AdminVenue>();
    let currentSlug: string | null = null;
    let drawerStatus = 'draft';
    let personEditingSlug: string | null = null; // null when creating new
    let personOriginalSlug: string | null = null;
    let venueEditingSlug: string | null = null;
    let venueOriginalSlug: string | null = null;

    function totalPending(): number {
      return pending.size + peoplePending.size + venuesPending.size;
    }

    function updateDownloadBtn() {
      const btn = document.getElementById('download-changes') as HTMLButtonElement;
      const n = totalPending();
      if (n > 0) {
        btn.style.display = '';
        btn.textContent = `Download changes (${n})`;
      } else {
        btn.style.display = 'none';
      }
    }

    // --- Drawer ---
    const overlay = document.getElementById('drawer-overlay') as HTMLDivElement;
    const drawer = document.getElementById('edit-drawer') as HTMLElement;

    function openDrawer(slug: string) {
      const base = DATA.find((r) => r.slug === slug);
      if (!base) return;
      const row = pending.get(slug) ?? base;
      currentSlug = slug;
      drawerStatus = row.status;

      (document.getElementById('drawer-title') as HTMLElement).textContent =
        row.preservedTitle || row.title;
      (document.getElementById('d-vimeoId') as HTMLInputElement).value = row.vimeoId;
      (document.getElementById('d-youtubeId') as HTMLInputElement).value = row.youtubeId;
      (document.getElementById('d-soundcloudUrl') as HTMLInputElement).value = row.soundcloudUrl;
      (document.getElementById('d-bandcampEmbedUrl') as HTMLInputElement).value = row.bandcampEmbedUrl;
      (document.getElementById('d-summary') as HTMLTextAreaElement).value = row.summary;
      (document.getElementById('d-tags') as HTMLInputElement).value = row.tags.join(', ');
      (document.getElementById('d-featuredOrder') as HTMLInputElement).value =
        row.featuredOrder === '' ? '' : String(row.featuredOrder);

      updateStatusBtns(drawerStatus);
      drawer.classList.add('open');
      overlay.classList.add('open');
    }

    function closeDrawer() {
      currentSlug = null;
      drawer.classList.remove('open');
      const personOpen = document.getElementById('person-drawer')?.classList.contains('open');
      const venueOpen = document.getElementById('venue-drawer')?.classList.contains('open');
      if (!personOpen && !venueOpen) overlay.classList.remove('open');
    }

    function updateStatusBtns(status: string) {
      drawerStatus = status;
      document.querySelectorAll<HTMLButtonElement>('.status-btns button').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.status === status);
      });
      (document.getElementById('featured-order-row') as HTMLElement).style.display =
        status === 'featured' ? 'flex' : 'none';
    }

    function saveDrawer() {
      if (!currentSlug) return;
      const base = DATA.find((r) => r.slug === currentSlug)!;
      const existing = pending.get(currentSlug) ?? { ...base };

      const rawTags = (document.getElementById('d-tags') as HTMLInputElement).value;
      const tags = rawTags.split(/[,|;]/).map((t) => t.trim()).filter(Boolean);
      const foRaw = (document.getElementById('d-featuredOrder') as HTMLInputElement).value;

      const merged: AdminRow = {
        ...existing,
        status: drawerStatus,
        featuredOrder: foRaw === '' ? '' : Number(foRaw),
        vimeoId: (document.getElementById('d-vimeoId') as HTMLInputElement).value.trim(),
        youtubeId: (document.getElementById('d-youtubeId') as HTMLInputElement).value.trim(),
        soundcloudUrl: (document.getElementById('d-soundcloudUrl') as HTMLInputElement).value.trim(),
        bandcampEmbedUrl: (document.getElementById('d-bandcampEmbedUrl') as HTMLInputElement).value.trim(),
        summary: (document.getElementById('d-summary') as HTMLTextAreaElement).value.trim(),
        tags,
      };

      pending.set(currentSlug, merged);
      const idx = DATA.findIndex((r) => r.slug === currentSlug);
      if (idx >= 0) Object.assign(DATA[idx], merged);

      updateDownloadBtn();
      renderTable();
      closeDrawer();
    }

    function cycleStatus(slug: string) {
      const base = DATA.find((r) => r.slug === slug);
      if (!base) return;
      const current = (pending.get(slug) ?? base).status;
      const next = current === 'draft' ? 'published' : current === 'published' ? 'featured' : 'draft';
      const existing = pending.get(slug) ?? { ...base };
      const merged = { ...existing, status: next };
      pending.set(slug, merged);
      const idx = DATA.findIndex((r) => r.slug === slug);
      if (idx >= 0) DATA[idx].status = next;
      updateDownloadBtn();
      renderTable();
    }

    async function downloadChanges() {
      const zip = new JSZip();
      for (const [slug, merged] of pending) {
        zip.file(`works/${slug}.md`, emitMarkdown(merged));
      }
      for (const [slug, merged] of peoplePending) {
        zip.file(`people/${slug}.json`, emitPersonJson(merged));
      }
      for (const [slug, merged] of venuesPending) {
        zip.file(`venues/${slug}.json`, emitVenueJson(merged));
      }
      const blob = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `sleepnod-changes-${new Date().toISOString().slice(0, 10)}.zip`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function emitPersonJson(p: AdminPerson): string {
      const out: Record<string, unknown> = {
        name: p.name,
      };
      if (p.preservedName) out.preservedName = p.preservedName;
      out.role = p.role;
      if (p.bio) out.bio = p.bio;
      out.links = p.links;
      if (p.archivePath) out.archivePath = p.archivePath;
      out.published = p.published;
      return JSON.stringify(out, null, 2) + '\n';
    }

    function emitVenueJson(v: AdminVenue): string {
      const out: Record<string, unknown> = {
        name: v.name,
      };
      if (v.preservedName) out.preservedName = v.preservedName;
      if (v.city) out.city = v.city;
      if (v.country) out.country = v.country;
      if (v.website) out.website = v.website;
      if (v.note) out.note = v.note;
      out.published = v.published;
      return JSON.stringify(out, null, 2) + '\n';
    }

    // --- Tab switching ---
    function activateTab(tab: string) {
      document.querySelectorAll<HTMLButtonElement>('.admin-tab').forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.tab === tab);
      });
      document.querySelectorAll<HTMLElement>('.admin-tab-panel').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tab;
      });
    }

    // --- People ---
    const peopleTbody = document.getElementById('people-tbody') as HTMLTableSectionElement;
    const peopleSearch = document.getElementById('people-search') as HTMLInputElement;
    const peopleCount = document.getElementById('people-count') as HTMLSpanElement;
    const personDrawer = document.getElementById('person-drawer') as HTMLElement;

    function currentPeopleList(): AdminPerson[] {
      const merged = PEOPLE.map((p) => peoplePending.get(p.slug) ?? p);
      for (const [slug, p] of peoplePending) {
        if (!merged.find((m) => m.slug === slug)) merged.push(p);
      }
      return merged.sort((a, b) => a.name.localeCompare(b.name));
    }

    function renderPeople() {
      const q = peopleSearch.value.trim().toLowerCase();
      const rows = currentPeopleList().filter((p) => {
        if (!q) return true;
        const hay = [p.name, p.preservedName, p.slug, p.role.join(' '), p.bio].join(' ').toLowerCase();
        return hay.includes(q);
      });
      peopleCount.textContent = `${rows.length} of ${currentPeopleList().length}`;
      peopleTbody.innerHTML = rows.map((p) => `
        <tr data-slug="${esc(p.slug)}" class="${peoplePending.has(p.slug) ? 'row-pending' : ''}">
          <td class="col-title title-cell">
            <strong>${esc(p.preservedName || p.name)}</strong>
            <small>${esc(p.slug)}</small>
          </td>
          <td>${esc(p.role.join(' · ') || '—')}</td>
          <td class="col-summary truncate" title="${esc(p.bio)}">${esc(p.bio || '—')}</td>
          <td>${p.links.length > 0 ? p.links.length : '—'}</td>
          <td>${p.published ? 'yes' : 'no'}</td>
        </tr>
      `).join('');
    }

    function openPersonDrawer(slug: string | null) {
      personEditingSlug = slug;
      personOriginalSlug = slug;
      const base = slug
        ? (peoplePending.get(slug) ?? PEOPLE.find((p) => p.slug === slug))
        : null;
      const p: AdminPerson = base ?? {
        slug: '', name: '', preservedName: '',
        role: [], bio: '', links: [], archivePath: '', published: true,
      };
      (document.getElementById('person-drawer-title') as HTMLElement).textContent =
        slug ? (p.preservedName || p.name || p.slug) : 'New person';
      (document.getElementById('p-slug') as HTMLInputElement).value = p.slug;
      (document.getElementById('p-name') as HTMLInputElement).value = p.name;
      (document.getElementById('p-preservedName') as HTMLInputElement).value = p.preservedName;
      (document.getElementById('p-role') as HTMLInputElement).value = p.role.join(', ');
      (document.getElementById('p-bio') as HTMLTextAreaElement).value = p.bio;
      (document.getElementById('p-archivePath') as HTMLInputElement).value = p.archivePath;
      (document.getElementById('p-published') as HTMLInputElement).checked = p.published;
      overlay.classList.add('open');
      personDrawer.classList.add('open');
    }

    function closePersonDrawer() {
      personEditingSlug = null;
      personOriginalSlug = null;
      personDrawer.classList.remove('open');
      if (!drawer.classList.contains('open') && !venueDrawer.classList.contains('open')) {
        overlay.classList.remove('open');
      }
    }

    function savePersonDrawer() {
      const slug = (document.getElementById('p-slug') as HTMLInputElement).value.trim();
      const name = (document.getElementById('p-name') as HTMLInputElement).value.trim();
      if (!slug || !name) {
        alert('Slug and name are required.');
        return;
      }
      const rawRole = (document.getElementById('p-role') as HTMLInputElement).value;
      const merged: AdminPerson = {
        slug,
        name,
        preservedName: (document.getElementById('p-preservedName') as HTMLInputElement).value.trim(),
        role: rawRole.split(/[,|;]/).map((t) => t.trim()).filter(Boolean),
        bio: (document.getElementById('p-bio') as HTMLTextAreaElement).value.trim(),
        links: (personOriginalSlug
          ? (peoplePending.get(personOriginalSlug) ?? PEOPLE.find((p) => p.slug === personOriginalSlug))?.links ?? []
          : []),
        archivePath: (document.getElementById('p-archivePath') as HTMLInputElement).value.trim(),
        published: (document.getElementById('p-published') as HTMLInputElement).checked,
      };
      peoplePending.set(slug, merged);
      updateDownloadBtn();
      renderPeople();
      closePersonDrawer();
    }

    // --- Venues ---
    const venuesTbody = document.getElementById('venues-tbody') as HTMLTableSectionElement;
    const venuesSearch = document.getElementById('venues-search') as HTMLInputElement;
    const venuesCount = document.getElementById('venues-count') as HTMLSpanElement;
    const venueDrawer = document.getElementById('venue-drawer') as HTMLElement;

    function currentVenuesList(): AdminVenue[] {
      const merged = VENUES.map((v) => venuesPending.get(v.slug) ?? v);
      for (const [slug, v] of venuesPending) {
        if (!merged.find((m) => m.slug === slug)) merged.push(v);
      }
      return merged.sort((a, b) => a.name.localeCompare(b.name));
    }

    function renderVenues() {
      const q = venuesSearch.value.trim().toLowerCase();
      const rows = currentVenuesList().filter((v) => {
        if (!q) return true;
        const hay = [v.name, v.preservedName, v.slug, v.city, v.country, v.note].join(' ').toLowerCase();
        return hay.includes(q);
      });
      venuesCount.textContent = `${rows.length} of ${currentVenuesList().length}`;
      venuesTbody.innerHTML = rows.map((v) => `
        <tr data-slug="${esc(v.slug)}" class="${venuesPending.has(v.slug) ? 'row-pending' : ''}">
          <td class="col-title title-cell">
            <strong>${esc(v.preservedName || v.name)}</strong>
            <small>${esc(v.slug)}</small>
          </td>
          <td>${esc(v.city || '—')}</td>
          <td>${esc(v.country || '—')}</td>
          <td>${v.website ? `<a href="${esc(v.website)}" target="_blank" rel="noopener">link ↗</a>` : '—'}</td>
          <td class="col-summary truncate" title="${esc(v.note)}">${esc(v.note || '—')}</td>
          <td>${v.published ? 'yes' : 'no'}</td>
        </tr>
      `).join('');
    }

    function openVenueDrawer(slug: string | null) {
      venueEditingSlug = slug;
      venueOriginalSlug = slug;
      const base = slug
        ? (venuesPending.get(slug) ?? VENUES.find((v) => v.slug === slug))
        : null;
      const v: AdminVenue = base ?? {
        slug: '', name: '', preservedName: '',
        city: '', country: '', website: '', note: '', published: true,
      };
      (document.getElementById('venue-drawer-title') as HTMLElement).textContent =
        slug ? (v.preservedName || v.name || v.slug) : 'New venue';
      (document.getElementById('v-slug') as HTMLInputElement).value = v.slug;
      (document.getElementById('v-name') as HTMLInputElement).value = v.name;
      (document.getElementById('v-preservedName') as HTMLInputElement).value = v.preservedName;
      (document.getElementById('v-city') as HTMLInputElement).value = v.city;
      (document.getElementById('v-country') as HTMLInputElement).value = v.country;
      (document.getElementById('v-website') as HTMLInputElement).value = v.website;
      (document.getElementById('v-note') as HTMLTextAreaElement).value = v.note;
      (document.getElementById('v-published') as HTMLInputElement).checked = v.published;
      overlay.classList.add('open');
      venueDrawer.classList.add('open');
    }

    function closeVenueDrawer() {
      venueEditingSlug = null;
      venueOriginalSlug = null;
      venueDrawer.classList.remove('open');
      if (!drawer.classList.contains('open') && !personDrawer.classList.contains('open')) {
        overlay.classList.remove('open');
      }
    }

    function saveVenueDrawer() {
      const slug = (document.getElementById('v-slug') as HTMLInputElement).value.trim();
      const name = (document.getElementById('v-name') as HTMLInputElement).value.trim();
      if (!slug || !name) {
        alert('Slug and name are required.');
        return;
      }
      const merged: AdminVenue = {
        slug,
        name,
        preservedName: (document.getElementById('v-preservedName') as HTMLInputElement).value.trim(),
        city: (document.getElementById('v-city') as HTMLInputElement).value.trim(),
        country: (document.getElementById('v-country') as HTMLInputElement).value.trim(),
        website: (document.getElementById('v-website') as HTMLInputElement).value.trim(),
        note: (document.getElementById('v-note') as HTMLTextAreaElement).value.trim(),
        published: (document.getElementById('v-published') as HTMLInputElement).checked,
      };
      venuesPending.set(slug, merged);
      updateDownloadBtn();
      renderVenues();
      closeVenueDrawer();
    }

    // --- Filters + sort ---
    let sortCol: keyof AdminRow = 'year';
    let sortDir: 'asc' | 'desc' = 'desc';
    let inited = false;

    const searchInput = document.getElementById('search') as HTMLInputElement;
    const statusSelect = document.getElementById('filter-status') as HTMLSelectElement;
    const mediumSelect = document.getElementById('filter-medium') as HTMLSelectElement;
    const rowCount = document.getElementById('row-count') as HTMLSpanElement;
    const tbody = document.getElementById('table-body') as HTMLTableSectionElement;
    const importResult = document.getElementById('import-result') as HTMLDivElement;

    function esc(s: unknown): string {
      return String(s ?? '').replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!
      ));
    }

    function flagsFor(r: AdminRow): string {
      const flags: string[] = [];
      if (!r.year) flags.push('<span class="flag">no year</span>');
      if (!r.summary) flags.push('<span class="flag">no summary</span>');
      if (!r.vimeoId && !r.youtubeId && !r.featuredImage) flags.push('<span class="flag">no media</span>');
      if (!r.role) flags.push('<span class="flag">no role</span>');
      if (r.status !== 'draft' && (!r.summary || !r.year || !r.role)) {
        flags.push('<span class="flag">publish-blocked</span>');
      }
      return flags.length > 0 ? flags.join('') : '<span class="flag ok">—</span>';
    }

    function embedBadges(r: AdminRow): string {
      const b = (label: string, on: boolean) =>
        `<span class="embed-badge${on ? ' embed-badge--on' : ''}">${label}</span>`;
      return b('V', !!r.vimeoId) + b('YT', !!r.youtubeId) + b('SC', !!r.soundcloudUrl) + b('BC', !!r.bandcampEmbedUrl);
    }

    function filtered(): AdminRow[] {
      const q = searchInput.value.trim().toLowerCase();
      const s = statusSelect.value;
      const m = mediumSelect.value;
      return DATA.filter((r) => {
        if (s !== 'all' && r.status !== s) return false;
        if (m !== 'all' && r.medium !== m) return false;
        if (q) {
          const hay = [r.title, r.slug, r.summary, r.role, r.venue, r.section, r.tags.join(' ')]
            .filter(Boolean).join(' ').toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });
    }

    function sorted(rows: AdminRow[]): AdminRow[] {
      return [...rows].sort((a, b) => {
        const va = a[sortCol];
        const vb = b[sortCol];
        const sa = Array.isArray(va) ? va.join(',') : String(va ?? '');
        const sb = Array.isArray(vb) ? vb.join(',') : String(vb ?? '');
        const cmp = sa.localeCompare(sb);
        return sortDir === 'asc' ? cmp : -cmp;
      });
    }

    function renderTable() {
      const rows = sorted(filtered());
      rowCount.textContent = `${rows.length} of ${DATA.length}`;

      document.querySelectorAll('.admin-table th').forEach((th) => {
        th.classList.remove('sort-asc', 'sort-desc');
        if ((th as HTMLElement).dataset.col === sortCol) {
          th.classList.add(sortDir === 'asc' ? 'sort-asc' : 'sort-desc');
        }
      });

      tbody.innerHTML = rows.map((r) => `
        <tr data-slug="${esc(r.slug)}" class="${pending.has(r.slug) ? 'row-pending' : ''}">
          <td class="col-thumb"><img class="thumb" src="${esc(r.thumbnail || PLACEHOLDER)}" alt="" loading="lazy"/></td>
          <td>
            <span class="status-pill ${esc(r.status)}" data-slug="${esc(r.slug)}" title="Click to cycle status">
              ${esc(r.status)}
            </span>
          </td>
          <td class="col-title title-cell">
            <strong>${esc(r.preservedTitle || r.title)}</strong>
            <small>${esc(r.slug)}</small>
          </td>
          <td>${esc(r.year ? r.year.slice(0, 4) : '—')}</td>
          <td>${esc(r.medium)}</td>
          <td class="col-embeds">${embedBadges(r)}</td>
          <td class="col-summary truncate" title="${esc(r.summary)}">${esc(r.summary || '—')}</td>
          <td class="col-flags">${flagsFor(r)}</td>
        </tr>
      `).join('');
    }

    function init() {
      if (inited) return;
      inited = true;

      searchInput.addEventListener('input', renderTable);
      statusSelect.addEventListener('change', renderTable);
      mediumSelect.addEventListener('change', renderTable);

      document.querySelectorAll<HTMLTableCellElement>('.admin-table th.sortable').forEach((th) => {
        th.addEventListener('click', () => {
          const col = th.dataset.col as keyof AdminRow;
          if (sortCol === col) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
          else { sortCol = col; sortDir = col === 'year' ? 'desc' : 'asc'; }
          renderTable();
        });
      });

      document.getElementById('export-csv')!.addEventListener('click', exportCsv);
      document.getElementById('import-csv')!.addEventListener('change', importCsv);
      document.getElementById('download-changes')!.addEventListener('click', downloadChanges);

      // Drawer events
      document.getElementById('drawer-close')!.addEventListener('click', closeDrawer);
      document.getElementById('drawer-cancel')!.addEventListener('click', closeDrawer);
      document.getElementById('drawer-save')!.addEventListener('click', saveDrawer);
      overlay.addEventListener('click', () => {
        closeDrawer();
        closePersonDrawer();
        closeVenueDrawer();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

      document.querySelectorAll<HTMLButtonElement>('.status-btns button').forEach((btn) => {
        btn.addEventListener('click', () => updateStatusBtns(btn.dataset.status!));
      });

      // Table row + pill click delegation
      tbody.addEventListener('click', (e) => {
        const pill = (e.target as Element).closest('.status-pill[data-slug]') as HTMLElement | null;
        if (pill) {
          e.stopPropagation();
          cycleStatus(pill.dataset.slug!);
          return;
        }
        const row = (e.target as Element).closest('tr[data-slug]') as HTMLElement | null;
        if (row) openDrawer(row.dataset.slug!);
      });

      // Tab switching
      document.querySelectorAll<HTMLButtonElement>('.admin-tab').forEach((btn) => {
        btn.addEventListener('click', () => activateTab(btn.dataset.tab!));
      });

      // People
      peopleSearch.addEventListener('input', renderPeople);
      document.getElementById('people-new')!.addEventListener('click', () => openPersonDrawer(null));
      peopleTbody.addEventListener('click', (e) => {
        const row = (e.target as Element).closest('tr[data-slug]') as HTMLElement | null;
        if (row) openPersonDrawer(row.dataset.slug!);
      });
      document.getElementById('person-drawer-close')!.addEventListener('click', closePersonDrawer);
      document.getElementById('person-drawer-cancel')!.addEventListener('click', closePersonDrawer);
      document.getElementById('person-drawer-save')!.addEventListener('click', savePersonDrawer);

      // Venues
      venuesSearch.addEventListener('input', renderVenues);
      document.getElementById('venues-new')!.addEventListener('click', () => openVenueDrawer(null));
      venuesTbody.addEventListener('click', (e) => {
        const row = (e.target as Element).closest('tr[data-slug]') as HTMLElement | null;
        if (row) openVenueDrawer(row.dataset.slug!);
      });
      document.getElementById('venue-drawer-close')!.addEventListener('click', closeVenueDrawer);
      document.getElementById('venue-drawer-cancel')!.addEventListener('click', closeVenueDrawer);
      document.getElementById('venue-drawer-save')!.addEventListener('click', saveVenueDrawer);

      // Escape closes any open drawer
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closePersonDrawer();
          closeVenueDrawer();
        }
      });

      renderTable();
      renderPeople();
      renderVenues();
    }

    // --- CSV columns ---
    const CSV_COLS: (keyof AdminRow)[] = [
      'slug', 'title', 'preservedTitle', 'year', 'medium', 'role', 'venue',
      'tags', 'section', 'summary', 'featuredImage',
      'vimeoId', 'vimeoPrivacy', 'youtubeId', 'soundcloudUrl', 'bandcampEmbedUrl',
      'status', 'featuredOrder', 'archivePath', 'rightsNote', 'substackUrl',
    ];

    function csvEscape(v: unknown): string {
      const s = Array.isArray(v) ? v.join('|') : String(v ?? '');
      return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    }

    function exportCsv() {
      const rows = sorted(filtered());
      const header = CSV_COLS.join(',');
      const lines = rows.map((r) => CSV_COLS.map((c) => csvEscape(r[c])).join(','));
      const csv = [header, ...lines].join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `sleepnod-works-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function parseCsv(text: string): string[][] {
      const out: string[][] = [];
      let row: string[] = [];
      let cell = '';
      let inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const c = text[i];
        if (inQuotes) {
          if (c === '"') {
            if (text[i + 1] === '"') { cell += '"'; i++; }
            else inQuotes = false;
          } else cell += c;
        } else {
          if (c === '"') inQuotes = true;
          else if (c === ',') { row.push(cell); cell = ''; }
          else if (c === '\n' || c === '\r') {
            if (c === '\r' && text[i + 1] === '\n') i++;
            row.push(cell); cell = '';
            if (row.length > 1 || row[0] !== '') out.push(row);
            row = [];
          } else cell += c;
        }
      }
      if (cell !== '' || row.length > 0) { row.push(cell); out.push(row); }
      return out;
    }

    // --- YAML frontmatter emit ---
    const FRONTMATTER_ORDER: string[] = [
      'title', 'preservedTitle', 'year', 'medium', 'role', 'venue',
      'tags', 'section', 'summary', 'featuredImage', 'gallery',
      'vimeoId', 'vimeoPrivacy', 'youtubeId', 'soundcloudUrl', 'bandcampEmbedUrl',
      'status', 'featuredOrder',
      'substackUrl', 'archivePath', 'rightsNote',
    ];

    function yamlScalar(v: unknown): string {
      if (typeof v === 'number') return String(v);
      if (typeof v === 'boolean') return String(v);
      const s = String(v ?? '');
      if (s === '') return "''";
      if (/^(true|false|null|yes|no|on|off)$/i.test(s)) return `'${s}'`;
      if (/^-?\d+(\.\d+)?$/.test(s)) return `'${s}'`;
      if (/[:#&*!|>'"%@`,\[\]{}\n]/.test(s) || /^\s|\s$/.test(s)) {
        return `'${s.replace(/'/g, "''")}'`;
      }
      return s;
    }

    function emitFrontmatter(row: Record<string, unknown>): string {
      const lines = ['---'];
      for (const key of FRONTMATTER_ORDER) {
        const val = row[key];
        if (val === undefined || val === null || val === '') continue;
        if (key === 'gallery') {
          const arr = val as Array<{ src: string; caption?: string }>;
          if (!Array.isArray(arr) || arr.length === 0) continue;
          lines.push('gallery:');
          for (const item of arr) {
            lines.push(`  - src: ${yamlScalar(item.src)}`);
            if (item.caption) lines.push(`    caption: ${yamlScalar(item.caption)}`);
          }
          continue;
        }
        if (Array.isArray(val)) {
          if (val.length === 0) continue;
          lines.push(`${key}:`);
          for (const item of val) lines.push(`  - ${yamlScalar(item)}`);
          continue;
        }
        lines.push(`${key}: ${yamlScalar(val)}`);
      }
      lines.push('---');
      return lines.join('\n');
    }

    function emitMarkdown(row: AdminRow): string {
      return `${emitFrontmatter(row as unknown as Record<string, unknown>)}\n\n${row.body ?? ''}\n`;
    }

    async function importCsv(e: Event) {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      const text = await file.text();
      input.value = '';

      const parsed = parseCsv(text);
      if (parsed.length === 0) { showImportError('Empty CSV.'); return; }
      const [headers, ...dataRows] = parsed;
      if (!headers.includes('slug')) { showImportError('CSV must include a `slug` column.'); return; }

      const origBySlug = new Map(DATA.map((d) => [d.slug, d]));
      const updates: Array<{ slug: string; merged: AdminRow; changes: string[] }> = [];
      const additions: Array<{ slug: string; merged: AdminRow }> = [];

      for (const cells of dataRows) {
        if (cells.every((c) => !c)) continue;
        const row: Record<string, string> = {};
        headers.forEach((h, i) => { row[h] = cells[i] ?? ''; });
        if (!row.slug) continue;

        const editable: Partial<AdminRow> = {};
        for (const col of CSV_COLS) {
          if (!(col in row)) continue;
          const raw = row[col];
          if (col === 'tags') {
            editable.tags = raw.split(/[|,;]/).map((t) => t.trim()).filter(Boolean);
          } else if (col === 'featuredOrder') {
            editable.featuredOrder = raw === '' ? '' : Number(raw);
          } else {
            (editable as Record<string, unknown>)[col] = raw;
          }
        }

        const orig = origBySlug.get(row.slug);
        if (orig) {
          const merged: AdminRow = { ...orig, ...(editable as AdminRow) };
          const changes: string[] = [];
          for (const k of Object.keys(editable) as (keyof AdminRow)[]) {
            if (JSON.stringify(merged[k]) !== JSON.stringify(orig[k])) changes.push(k);
          }
          if (changes.length > 0) updates.push({ slug: row.slug, merged, changes });
        } else {
          const merged: AdminRow = {
            slug: row.slug,
            file: `src/content/works/${row.slug}.md`,
            title: '', preservedTitle: '', year: '', medium: 'other',
            role: '', venue: '', tags: [], section: '', summary: '',
            featuredImage: '', vimeoId: '', vimeoPrivacy: 'public',
            youtubeId: '', soundcloudUrl: '', bandcampEmbedUrl: '',
            status: 'draft', featuredOrder: '', archivePath: '',
            rightsNote: '', substackUrl: '', gallery: [], body: '',
            thumbnail: null,
            ...(editable as AdminRow),
          };
          additions.push({ slug: row.slug, merged });
        }
      }

      if (updates.length === 0 && additions.length === 0) {
        showImportInfo('CSV parsed, no changes detected.');
        return;
      }

      const zip = new JSZip();
      [...updates, ...additions].forEach(({ slug, merged }) => {
        zip.file(`${slug}.md`, emitMarkdown(merged));
      });
      const blob = await zip.generateAsync({ type: 'blob' });
      const url = URL.createObjectURL(blob);

      importResult.hidden = false;
      importResult.innerHTML = `
        <strong>Import preview</strong>
        <ul>
          <li>${updates.length} updated</li>
          <li>${additions.length} added</li>
        </ul>
        ${updates.length > 0 ? `<strong>Updated slugs</strong><ul>${
          updates.map((u) => `<li>${esc(u.slug)} — ${u.changes.map(esc).join(', ')}</li>`).join('')
        }</ul>` : ''}
        ${additions.length > 0 ? `<strong>Added slugs</strong><ul>${
          additions.map((a) => `<li>${esc(a.slug)}</li>`).join('')
        }</ul>` : ''}
        <a class="admin-btn" href="${url}" download="sleepnod-works-${new Date().toISOString().slice(0, 10)}.zip">Download .md zip</a>
        <p style="margin-top: 0.75rem;">
          Unzip into <code>src/content/works/</code> (overwriting), then
          <code>git add src/content/works && git commit -m "update works" && git push</code>.
        </p>
      `;
    }

    function showImportInfo(msg: string) {
      importResult.hidden = false;
      importResult.innerHTML = `<strong>${esc(msg)}</strong>`;
    }
    function showImportError(msg: string) {
      importResult.hidden = false;
      importResult.innerHTML = `<strong style="color:#d46040;">${esc(msg)}</strong>`;
    }

    // --- Kick off (after all vars + fns are declared) ---
    if (sessionStorage.getItem(STORAGE_KEY) === '1') {
      gate.style.display = 'none';
      admin.style.display = 'block';
      init();
    }
  </script>
</Base>
