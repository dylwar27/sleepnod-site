---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => data.status !== 'draft');
  const sections = Array.from(new Set(
    works.map((w) => w.data.section).filter((s): s is string => !!s)
  ));
  return sections.map((section) => ({
    params: { slug: section },
    props: {
      section,
      works: works
        .filter((w) => w.data.section === section)
        .sort((a, b) => b.data.year.localeCompare(a.data.year)),
    },
  }));
}

const { section, works } = Astro.props;
const title = section.replace(/-/g, ' ');
---
<Base title={`${title} — SLEEP NOD`}>
  <section class="container" style="padding-block: 3rem 2rem;">
    <div class="section-label">Section</div>
    <h1 style="font-family: var(--serif); font-weight: 700; font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.05; margin: 0; text-transform: capitalize;">{title}</h1>
  </section>
  <section class="container">
    <div class="work-grid work-grid--dense">
      {works.map((w) => <WorkCard work={w} />)}
    </div>
  </section>
</Base>
